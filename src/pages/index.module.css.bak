/**
 * CSS files with the .module.css suffix will be treated as CSS modules
 * and scoped locally.
 */

.homeContainer {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: calc(100vh - var(--ifm-navbar-height));
  padding: 2rem;
}

// .bak is used as a backup version - this file has no value without removing .bak
